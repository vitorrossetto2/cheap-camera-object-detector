RTSP_URL=rtsp://user:password@camera-ip:554/stream1
RTSP_TRANSPORT=udp
OPENCV_FFMPEG_CAPTURE_OPTIONS=rtsp_transport;udp

CAPTURE_ATTEMPTS=2
CAPTURE_WARMUP_FRAMES=1
CAPTURE_OPEN_TIMEOUT_MS=5000
CAPTURE_READ_TIMEOUT_MS=5000

DETECTION_TARGET=dog
DETECTION_MODEL=yolo11n.pt
DETECTION_CONFIDENCE=0.35
DETECTION_IMAGE_SIZE=640
DETECTION_FRAME_INTERVAL_SECONDS=0.2
DETECTION_MAX_FRAMES=0
MONITOR_FRAME_READ_ATTEMPTS=2

ALERT_COOLDOWN_SECONDS=5
BEEP_FREQUENCY_HZ=1200
BEEP_DURATION_MS=2000

LOG_LEVEL=INFO
